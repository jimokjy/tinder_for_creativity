# Настройки docker-compose для запуска на внешнем (не localhost) сервере.
# Docker Compose подхватывает этот файл автоматически, если он называется
# .env и лежит рядом с docker-compose.yml.
#
#   cp .env.example .env

# Внешние порты, на которых сервисы будут доступны с хост-машины
# (например, если 8000/3000 на сервере уже чем-то заняты).
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Публичный адрес бэкенда, который "запекается" во фронтенд при сборке
# (см. комментарий про rewrites() в DOCKER.md). По умолчанию используется
# внутренний адрес docker-сети (http://backend:8000) — он подходит, пока
# оба сервиса запускаются этим же docker-compose на одном сервере.
#
# Меняйте BACKEND_URL, только если бэкенд вынесен на отдельный внешний
# сервер/домен (не как сосед этого docker-compose) — тогда впишите его
# публичный адрес, например:
# BACKEND_URL=https://api.example.ru
BACKEND_URL=http://backend:8000

# --- Вход через ЛК Силаэдра (OpenID Connect) ---
# В отличие от остальных настроек бэкенда (они в tinder-backend/.env),
# эти передаются в контейнер прямо из docker-compose.yml — отсюда.
# Если что-то из этого уже задано в tinder-backend/.env, перенесите
# значения сюда: docker-compose.yml всегда берёт эти переменные из
# корневого .env, а не из tinder-backend/.env.

# Публичный адрес сайта (фронтенда) — сюда бэкенд редиректит браузер
# после входа через Силаэдр.
APP_URL=https://example.ru

CRM_OIDC_ENABLED=true
CRM_OIDC_ISSUER=https://lk.silaeder.ru
CRM_OIDC_CLIENT_ID=tinder
# Секрет OAuth-клиента, выданный в панели ЛК Силаэдра при регистрации.
CRM_OIDC_CLIENT_SECRET=changeme
# Должен точно совпадать с Redirect URI, зарегистрированным в ЛК
# Силаэдра: {APP_URL}/auth/silaeder/callback
CRM_OIDC_REDIRECT_URI=https://example.ru/auth/silaeder/callback

# Отдельный секрет для временной сессии authlib (state/nonce на время
# хендшейка) — НЕ путать с JWT_SECRET_KEY из tinder-backend/.env.
# Сгенерируйте свой: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=changeme
