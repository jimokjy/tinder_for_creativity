# Внешние порты, на которых сервисы будут доступны с хост-машины.
# Docker Compose подхватывает этот файл автоматически, если он называется
# .env и лежит рядом с docker-compose.yml — скопируйте его и при желании
# поменяйте порты (например, если 8000/3000 уже заняты).
BACKEND_PORT=8000
FRONTEND_PORT=3000
