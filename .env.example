# Настройки docker-compose для запуска на внешнем (не localhost) сервере.
# Docker Compose подхватывает этот файл автоматически, если он называется
# .env и лежит рядом с docker-compose.yml.
#
#   cp .env.example .env

# Внешние порты, на которых сервисы будут доступны с хост-машины
# (например, если 8000/3000 на сервере уже чем-то заняты).
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Публичный адрес бэкенда, который "запекается" во фронтенд при сборке
# (см. комментарий про rewrites() в DOCKER.md). По умолчанию используется
# внутренний адрес docker-сети (http://backend:8000) — он подходит, пока
# оба сервиса запускаются этим же docker-compose на одном сервере.
#
# Меняйте BACKEND_URL, только если бэкенд вынесен на отдельный внешний
# сервер/домен (не как сосед этого docker-compose) — тогда впишите его
# публичный адрес, например:
# BACKEND_URL=https://api.example.ru
BACKEND_URL=http://backend:8000
