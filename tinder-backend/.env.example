# Скопируйте этот файл в .env и настройте под себя.

# По умолчанию используется SQLite (файл app.db). Для продакшена:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/creations_db

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
CORS_ORIGINS=http://localhost:3000
AUTO_HIDE_REPORT_THRESHOLD=5

# Секрет для подписи JWT-токенов авторизации.
# Сгенерируйте свой: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme
JWT_EXPIRE_DAYS=30

# --- Вход через ЛК Силаэдра (OpenID Connect) ---
# Публичный адрес сайта — сюда редиректим браузер после входа.
APP_URL=http://localhost:3000

CRM_OIDC_ENABLED=true
CRM_OIDC_ISSUER=https://lk.silaeder.ru
CRM_OIDC_CLIENT_ID=tinder
CRM_OIDC_CLIENT_SECRET=changeme
# Должен точно совпадать с Redirect URI, зарегистрированным в ЛК Силаэдра.
CRM_OIDC_REDIRECT_URI=http://localhost:3000/auth/silaeder/callback

# Отдельный секрет для временной сессии authlib (state/nonce на время
# хендшейка) — НЕ путать с JWT_SECRET_KEY.
SESSION_SECRET_KEY=changeme

# Почта для ссылки подтверждения привязки (когда email из Силаэдра
# совпал с уже существующим локальным аккаунтом). Если не задать —
# ссылка просто пишется в лог сервера (удобно для разработки).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true
