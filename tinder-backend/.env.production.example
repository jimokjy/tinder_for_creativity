# Пример .env для запуска на сервере (публичный домен), в отличие от
# tinder-backend/.env.example, который рассчитан на локальный запуск
# (localhost). Скопируйте в tinder-backend/.env и замените все
# "changeme" / example.ru на свои значения.

# SQLite подходит и для продакшена при небольшой нагрузке — файл лежит
# в отдельном docker-томе (см. docker-compose.yml), данные не теряются
# при пересборке. Для нагрузки повыше — PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@db:5432/creations_db

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
# Домен(ы) фронтенда, разделённые запятой, БЕЗ слэша на конце.
CORS_ORIGINS=https://example.ru
AUTO_HIDE_REPORT_THRESHOLD=5

# Секрет для подписи JWT-токенов авторизации. ОБЯЗАТЕЛЬНО сгенерируйте
# свой уникальный секрет — если оставить значение из примера, токены
# сможет подделать кто угодно:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme
JWT_EXPIRE_DAYS=30

# --- Вход через ЛК Силаэдра (OpenID Connect) ---
# Публичный адрес сайта (фронтенда) — сюда редиректим браузер после входа.
APP_URL=https://example.ru

CRM_OIDC_ENABLED=true
CRM_OIDC_ISSUER=https://lk.silaeder.ru
CRM_OIDC_CLIENT_ID=tinder
CRM_OIDC_CLIENT_SECRET=changeme
# Должен точно совпадать с Redirect URI, зарегистрированным в ЛК Силаэдра
# для продакшен-домена (не localhost!).
CRM_OIDC_REDIRECT_URI=https://example.ru/auth/silaeder/callback

# Отдельный секрет для временной сессии authlib (state/nonce на время
# хендшейка) — НЕ путать с JWT_SECRET_KEY. Тоже сгенерируйте отдельным
# вызовом той же команды, что и для JWT_SECRET_KEY (не переиспользуйте
# один и тот же секрет для обоих).
SESSION_SECRET_KEY=changeme

# --- Почта (для ссылки подтверждения привязки аккаунта) ---
# На проде нужен реальный SMTP — если оставить пустым, ссылка попадёт
# только в лог контейнера, и пользователь её не получит.
MAIL_HOST=smtp.example.ru
MAIL_PORT=587
MAIL_USERNAME=changeme
MAIL_PASSWORD=changeme
MAIL_FROM=noreply@example.ru
MAIL_USE_TLS=true
